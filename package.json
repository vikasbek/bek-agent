{
  "name": "etbek",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "turbo run dev",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev:api": "tsx apps/api/src/server.ts",
    "dev:worker": "tsx apps/worker/src/worker.ts",
    "dev:web": "pnpm --filter @etbek/web dev"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "turbo": "^2.1.3",
    "typescript": "^5.5.4"
  }
}
